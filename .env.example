# Copy to .env and change values. NEVER commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (docker-compose reads these too)
POSTGRES_USER=nexusops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexusops
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend (used when running the API on the host, outside Docker)
DATABASE_URL=postgresql+asyncpg://nexusops:change-me@localhost:5432/nexusops
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Auth: signs login tokens. Must be 32+ random characters; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
